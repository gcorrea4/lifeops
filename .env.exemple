DB_HOST=localhost
DB_PORT=3306
DB_NAME=lifeops
DB_USER=your_user
DB_PASSWORD=your_password

# AI provider
# Set to "watsonx" in production. Leave as "mock" for local development.
AI_PROVIDER=mock

# IBM watsonx credentials — fill in for production use; never commit real values
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
